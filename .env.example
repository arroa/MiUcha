# Local, sin Clerk. El código lo ignora cuando NODE_ENV=production.
APP_DEV_BYPASS=true
DEV_SESSION_SECRET=
CHILD_SESSION_SECRET=

# Superusuario. npm run setup:admin lo crea en Clerk.
SUPER_ADMIN_EMAIL=

MONGODB_URI=
MONGODB_DB_NAME=miucha

# Adultos. Sin estas keys, el bypass local puede crear banqueros con id dev:
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Vercel Cron. La ruta /api/cron/daily exige este valor.
CRON_SECRET=
